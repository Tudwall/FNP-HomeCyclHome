generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model app_user {
  id                Int                 @id @default(autoincrement())
  email             String              @unique @db.VarChar(50)
  password          String              @db.VarChar(50)
  first_name        String              @db.VarChar(50)
  last_name         String              @db.VarChar(50)
  is_active         Boolean             @default(true)
  created_on        DateTime            @default(now()) @db.Timestamp(6)
  updated_on        DateTime?           @updatedAt @db.Timestamp(6)
  deleted_on        DateTime?           @db.Timestamp(6)
  bike              bike[]
  comment           comment[]
  intervention      intervention[]
  user_full_address user_full_address[]
  user_permission   user_permission[]
  user_role         user_role[]
}

model bike {
  id           Int            @id @default(autoincrement())
  created_on   DateTime       @default(now()) @db.Timestamp(6)
  updated_on   DateTime?      @updatedAt @db.Timestamp(6)
  deleted_on   DateTime?      @db.Timestamp(6)
  id_1         Int
  user_id      Int
  type_id      Int
  bike_model   bike_model     @relation(fields: [id_1], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bike_type    bike_type      @relation(fields: [type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  app_user     app_user       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  intervention intervention[]
}

model bike_brand {
  id         Int          @id @default(autoincrement())
  brand_name String?      @db.VarChar(50)
  bike_model bike_model[]
}

model bike_model {
  id         Int        @id @default(autoincrement())
  model_name String?    @db.VarChar(50)
  brand_id   Int
  bike       bike[]
  bike_brand bike_brand @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model bike_type {
  id        Int     @id @default(autoincrement())
  bike_type String? @db.VarChar(50)
  bike      bike[]
}

model comment {
  id              Int          @id @default(autoincrement())
  text            String       @db.VarChar(1000)
  created_on      DateTime     @default(now()) @db.Timestamp(6)
  user_id         Int
  intervention_id Int
  intervention    intervention @relation(fields: [intervention_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  app_user        app_user     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model company_info {
  id              Int          @id @default(autoincrement())
  name            String       @db.VarChar(50)
  description     String       @db.VarChar(300)
  phone_number    String       @db.VarChar(12)
  linkedin_link   String?      @db.VarChar(100)
  facebook_link   String?      @db.VarChar(100)
  twitter_link    String?      @db.VarChar(100)
  instagram_link  String?      @db.VarChar(100)
  full_address_id Int          @unique
  full_address    full_address @relation(fields: [full_address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model file {
  id              Int          @id @default(autoincrement())
  mime_type       mime_type
  url             String       @db.VarChar(200)
  intervention_id Int
  intervention    intervention @relation(fields: [intervention_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model full_address {
  id                Int                 @id @default(autoincrement())
  number            String?             @db.VarChar(50)
  street            String?             @db.VarChar(150)
  postal_code       String?             @db.VarChar(10)
  locality          String?             @db.VarChar(100)
  region            String?             @db.VarChar(100)
  country           String?             @db.VarChar(100)
  zone_id           Int                 @unique
  company_info      company_info?
  zone              zone                @relation(fields: [zone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_full_address user_full_address[]
}

model interval_ {
  id           Int            @id @default(autoincrement())
  start_date   DateTime       @db.Timestamp(6)
  end_date     DateTime       @db.Timestamp(6)
  intervention intervention[]
}

model intervention {
  id              Int                 @id @default(autoincrement())
  status          intervention_status
  is_cancelled    Boolean?
  cancelled_on    DateTime?           @db.Timestamp(6)
  created_on      DateTime            @default(now()) @db.Timestamp(6)
  updated_on      DateTime?           @updatedAt @db.Timestamp(6)
  deleted_on      DateTime?           @db.Timestamp(6)
  intervention_id Int
  job_id          Int
  mechanic_id     Int
  cycle_id        Int
  comment         comment[]
  file            file[]
  bike            bike                @relation(fields: [cycle_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  interval_       interval_           @relation(fields: [intervention_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  job             job                 @relation(fields: [job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  app_user        app_user            @relation(fields: [mechanic_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment         payment[]
}

model job {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(100)
  price        Decimal        @db.Decimal(6, 2)
  duration     String         @db.VarChar(50)
  intervention intervention[]
}

model payment {
  id              Int            @id @default(autoincrement())
  status          payment_status
  type            payment_type
  amount          Decimal        @db.Decimal(8, 2)
  created_on      DateTime       @default(now()) @db.Timestamp(6)
  updated_on      DateTime?      @updatedAt @db.Timestamp(6)
  intervention_id Int
  intervention    intervention   @relation(fields: [intervention_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model permission {
  id              Int               @id
  permission      String            @db.VarChar(50)
  role_permission role_permission[]
  user_permission user_permission[]
}

model role {
  id              Int               @id
  label           String            @db.VarChar(50)
  role_permission role_permission[]
  user_role       user_role[]
}

model role_permission {
  role_id        Int
  permissions_id Int
  permission     permission @relation(fields: [permissions_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role           role       @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([role_id, permissions_id])
}

model user_full_address {
  user_id         Int
  full_address_id Int
  full_address    full_address @relation(fields: [full_address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  app_user        app_user     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, full_address_id])
}

model user_permission {
  user_id       Int
  permission_id Int
  permission    permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  app_user      app_user   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, permission_id])
}

model user_role {
  user_id  Int
  role_id  Int
  role     role     @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  app_user app_user @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, role_id])
}

model zone {
  id           Int                     @id
  coordinates  Unsupported("geometry")
  label        String                  @db.VarChar(50)
  created_on   DateTime                @default(now()) @db.Timestamp(6)
  updated_on   DateTime?               @updatedAt @db.Timestamp(6)
  deleted_on   DateTime?               @db.Timestamp(6)
  full_address full_address?
}

enum intervention_status {
  pending
  done
  cancelled
}

enum mime_type {
  image_jpeg @map("image/jpeg")
  image_png  @map("image/png")
}

enum payment_status {
  processed
  awaiting
}

enum payment_type {
  debit_card
  cash
}
